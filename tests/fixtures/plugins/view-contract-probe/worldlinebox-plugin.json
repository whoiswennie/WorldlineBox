{
  "manifestVersion": 1,
  "id": "com.worldlinebox.view-contract-probe",
  "version": "1.0.0",
  "name": "View Contract Probe",
  "description": "Records host view-contract messages for PLUGIN view E2E (WorldlineBox-ex46.7).",
  "author": "WorldlineBox",
  "license": "MIT",
  "engines": {
    "worldlinebox": ">=0.1.0 <1.0.0",
    "pluginApi": 1
  },
  "runtime": {
    "mode": "restricted",
    "entry": "entry/main.js"
  },
  "permissions": [
    "ui.workspace"
  ],
  "contributes": {
    "commands": [],
    "menus": {},
    "toolbar": [],
    "inspector": [],
    "viewerActions": [],
    "views": [
      {
        "id": "probe-view",
        "title": "View contract probe",
        "location": "sidebar",
        "entry": "dist/ui/sidebar.html"
      }
    ],
    "settings": [],
    "hooks": [],
    "jobs": [],
    "providers": []
  }
}

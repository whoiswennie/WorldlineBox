# ufbx WASM 组件随仓库分发，prepackage/premake 门禁（verify-ufbx-wasm.mjs）
# 按字节 SHA-256 校验。任何行尾转换（CRLF）都会导致哈希漂移、打包失败，
# 因此整个目录标记为 -text（不做换行符转换）。
resources/ufbx/* -text
# VCP sources are preserved and verified against the upstream bytes.
vendor/vcp-memory/** -text
# The standalone memory module also pins upstream source hashes byte-for-byte.
resources/vcp-memory/** -text
*.bat text eol=crlf
# Reviewed tool inventory is hashed byte-for-byte on every operating system.
resources/portable-tools/manifests/*.json text eol=lf
# Pinned source models must be materialized with git lfs pull before packaging.
resources/speech-models/tokens.txt -text
public/companion-call/deepseek/** -text
# Retain the author's original CRLF and intentional Markdown hard breaks in the supplied license.
public/companion-call/deepseek/MODEL-LICENSE.txt -whitespace
resources/speech-models/*.onnx filter=lfs diff=lfs merge=lfs -text
resources/embedding-models/*.gguf filter=lfs diff=lfs merge=lfs -text
public/companion-call/deepseek/*.moc3 filter=lfs diff=lfs merge=lfs -text
public/companion-call/deepseek/**/*.png filter=lfs diff=lfs merge=lfs -text
public/companion-call/ringtone.wav -text
tests/fixtures/media/*.wav -text
tests/fixtures/media/*.mp3 -text

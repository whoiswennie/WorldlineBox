# Worldline ships these audited native video tools as Git LFS release inputs.
!resources/tools/ffmpeg/windows-x64/ffmpeg.exe
!resources/tools/ffmpeg/windows-x64/ffprobe.exe
!resources/tools/ffmpeg/windows-x64/ffplay.exe
!resources/tools/yt-dlp/windows-x64/yt-dlp.exe

# The embedded Python runtime is part of the distributable application.
# Keep this override after the global Python and executable rules so every
# runtime file under resources/python is versioned, including .exe and .pyd.
!resources/python/
!resources/python/**
# Runtime import/QA can regenerate bytecode inside the bundled interpreter.
# Keep the interpreter itself versioned without committing machine-local caches.
resources/python/**/__pycache__/
resources/python/**/*.py[cod]

# MinGit is an application runtime, not a user prerequisite. Keep its complete
# executable tree versioned so memory/workspace history works out of the box.
!resources/git/
!resources/git/**

# Keep FFmpeg's documentation and presets in Git. Gitee Community repositories
# cap individual files at 50 MB, so the runtime executables stay local.
!resources/ffmpeg/
!resources/ffmpeg/**
resources/ffmpeg/bin/*.exe

# Debug
.chrome/

# Memory and data files (optional, if you don't want to commit user data)
# memory/

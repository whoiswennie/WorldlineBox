    "@deepseek-ai/dsh-worldline-compiler": "workspace:^",
    "@deepseek-ai/dsh-worldline-project-local": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-worldline-project": "workspace:^",

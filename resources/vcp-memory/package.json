{
  "name": "vcp-memory",
  "version": "0.1.0",
  "description": "Standalone, source-preserving VCP memory and context runtime with an agent CLI",
  "private": true,
  "main": "lib/client.cjs",
  "bin": {
    "vcp-memory": "bin/vcp-memory.cjs"
  },
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "verify:upstream": "node scripts/snapshot-upstream.cjs --verify",
    "verify": "node scripts/verify-integrity.cjs",
    "test:upstream": "node scripts/run-upstream-tests.cjs",
    "test:live": "node scripts/validate-live.cjs",
    "snapshot": "node scripts/snapshot-upstream.cjs"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "upstream",
    "vendor",
    "references",
    "docs",
    "tests",
    "examples",
    "reports/*.json",
    "README.md",
    "LICENSE",
    ".agents"
  ],
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@node-rs/jieba": "^2.0.1",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "chinese-lunar-calendar": "^1.0.1",
    "chokidar": "^3.5.3",
    "commander": "^14.0.3",
    "dayjs": "^1.11.15",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fs-extra": "^10.1.0",
    "https-proxy-agent": "^7.0.4",
    "iconv-lite": "^0.6.3",
    "jsdom": "^24.1.3",
    "koffi": "^3.3.6",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.1",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "pdf-parse": "^1.1.4",
    "pdf-poppler": "^0.2.3",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.5",
    "triviumdb": "^0.8.5",
    "turndown": "^7.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
